# Copy this file to .env before running docker-compose

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/agent

# GitHub (for Phase 1: fetching failed pipeline logs)
GITHUB_TOKEN=ghp_xxx_your_personal_access_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# Phase 2: guardrails
# Diagnoses below this confidence (0-100) get retried, then escalated to a human instead of acted on.
CONFIDENCE_THRESHOLD=70
# Max additional diagnosis attempts per incident before escalating.
MAX_RETRIES=2
# Per-incident spend cap. Ollama itself is free, so this is enforced against an
# estimated cost (see COST_PER_1K_*_TOKENS_USD) modeled on paid-API pricing —
# real and testable today, and meaningful the day a paid model gets swapped in.
COST_CEILING_USD=0.05
COST_PER_1K_PROMPT_TOKENS_USD=0.00015
COST_PER_1K_COMPLETION_TOKENS_USD=0.0006
# true (default): fixes are proposed but never actually applied to GitHub.
# false: an approved, auto-applicable fix (currently: "dependency" incidents
# on a real GitHub run) is actually committed, verified via a CI rerun, and
# merged or rolled back.
DRY_RUN=true

# App
PORT=3000
